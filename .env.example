# Beispielkonfiguration für /etc/delikatessen/env (N-16).
# Die echte Datei liegt nur auf dem Server und gehört nicht ins Repository.

# Datenbank und Bilder
DELIKATESSEN_DATA_DIR=/var/lib/delikatessen

# Gebautes Frontend, setzt deploy/install.sh
DELIKATESSEN_FRONTEND_DIR=/opt/delikatessen/current/frontend

# IP-Adresse des nginx-LXC. Nur von dort wird X-Forwarded-For akzeptiert.
DELIKATESSEN_TRUSTED_PROXIES=192.0.2.10

# Zeitzone für "heute" und den Wochenbeginn
DELIKATESSEN_TIMEZONE=Europe/Berlin

# Schlüssel für gespeicherte Zugangsdaten wie Bring!. deploy/install.sh erzeugt ihn, falls er fehlt.
# Geht er verloren, müssen die Zugangsdaten in der App neu eingegeben werden.
DELIKATESSEN_SECRET_KEY=

# KI über das Gateway im LXC ki-gateway (Stufe 2, docs/betrieb.md). Leer = App läuft ohne KI.
# Adresse des Gateways, etwa http://192.0.2.20:4000
DELIKATESSEN_KI_BASE_URL=
# Virtueller Schlüssel mit Monatsbudget aus dem Gateway, nie der Master-Key
DELIKATESSEN_KI_API_KEY=
# Alias im Gateway und Gründlichkeit (low, medium, high)
DELIKATESSEN_KI_MODEL=rezept-extraktion
DELIKATESSEN_KI_EFFORT=medium
# output_config = strukturierte Ausgabe. Nur falls "delikatessen ki-pruefen" daran scheitert: none
DELIKATESSEN_KI_STRUCTURED=output_config

# Absender für Benachrichtigungen (Web Push). Eine Adresse, unter der man erreichbar ist.
DELIKATESSEN_PUSH_CONTACT=mailto:familie@example.org
