# Beispielkonfiguration für /etc/delikatessen/env (N-16).
# Die echte Datei liegt nur auf dem Server und gehört nicht ins Repository.

# Datenbank und Bilder
DELIKATESSEN_DATA_DIR=/var/lib/delikatessen

# Gebautes Frontend, setzt deploy/install.sh
DELIKATESSEN_FRONTEND_DIR=/opt/delikatessen/current/frontend

# IP-Adresse des nginx-LXC. Nur von dort wird X-Forwarded-For akzeptiert.
DELIKATESSEN_TRUSTED_PROXIES=192.0.2.10

# Zeitzone für "heute" und den Wochenbeginn
DELIKATESSEN_TIMEZONE=Europe/Berlin
