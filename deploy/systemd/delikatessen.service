[Unit]
Description=Delikatessen Wochenplan
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=delikatessen
Group=delikatessen
EnvironmentFile=/etc/delikatessen/env
ExecStart=/opt/delikatessen/current/venv/bin/delikatessen serve --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

# Härtung: nur das Datenverzeichnis ist beschreibbar
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/delikatessen
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
