# Beispiel für den vorhandenen nginx-LXC. Domain, Zertifikat, NetBird-Netz und Adresse anpassen.
# Erreichbar nur über NetBird, auch wenn derselbe nginx andere Seiten ins Internet ausliefert (N-10).
# Passt zu nginx 1.22 aus Debian 12 (dort gibt es "http2 on;" noch nicht).

server {
    listen 443 ssl;
    server_name delikatessen.example.org;

    ssl_certificate     /etc/letsencrypt/live/example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.org/privkey.pem;

    # Nur Geräte im NetBird. Netz aus dem NetBird-Dashboard (Settings › Networks), Vorgabe liegt in 100.64.0.0/10.
    # Alle anderen bekommen 403, auch Geräte im Heimnetz ohne NetBird.
    allow 100.64.0.0/10;
    deny all;

    # Import per Foto: bis zu 4 Fotos mit je bis zu 15 MB in einer Anfrage
    client_max_body_size 64m;

    location / {
        # Feste Adresse statt Hostname: Ein nicht auflösbarer Name hielte den ganzen nginx beim Start an
        proxy_pass http://192.0.2.20:8000;
        proxy_set_header Host $host;
        # Die App nimmt den letzten Eintrag und nur, wenn die Anfrage von DELIKATESSEN_TRUSTED_PROXIES kommt
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 90s;
    }
}
