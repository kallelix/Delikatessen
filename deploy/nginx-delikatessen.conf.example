# Beispiel für den vorhandenen nginx-LXC. Domain, Zertifikat und Adresse anpassen.
# Erreichbar nur über NetBird, nichts wird ins Internet freigegeben (N-10).

server {
    listen 443 ssl;
    http2 on;
    server_name delikatessen.example.org;

    ssl_certificate     /etc/letsencrypt/live/delikatessen.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/delikatessen.example.org/privkey.pem;

    # Rezeptfotos dürfen groß sein
    client_max_body_size 16m;

    location / {
        proxy_pass http://192.0.2.20:8000;
        proxy_set_header Host $host;
        # Die App wertet nur diesen Header aus und nur, wenn die Anfrage von hier kommt
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }
}
