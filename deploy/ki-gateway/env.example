# Vorlage für deploy/ki-gateway/.env im Gateway-LXC. Die echte Datei gehört nicht ins Repository (N-16).
# Rechte: chmod 600 .env

# Schlüssel der Anthropic-API. Liegt nur hier im Gateway.
ANTHROPIC_API_KEY=

# Verwaltungsschlüssel des Gateways, beginnt mit sk-. Erzeugen: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=

# Passwort der Gateway-Datenbank. Erzeugen: openssl rand -hex 24
POSTGRES_PASSWORD=
